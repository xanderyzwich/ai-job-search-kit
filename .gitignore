# --- Personal data: never tracked ---
/private/
/output/
# NOTE: /temp/ is deliberately NOT ignored. The working temp/ lives at
# private/temp/ (created by bootstrap, already covered by /private/ above).
# A repo-root temp/ is not a sanctioned directory, so anything appearing
# there is a mistake — most likely a day's notes written to the wrong path.
# Leaving it un-ignored means git status surfaces it instead of hiding it.

# --- Windows/WSL artifacts ---
*:Zone.Identifier
.DS_Store
Thumbs.db

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Editor/OS cruft ---
*.swp
*~

# --- Generated documents: belt-and-suspenders. These should only ever
#     exist under /private or /output (already ignored above), but block
#     by extension too in case one gets created somewhere else by mistake.
*.docx
*.pdf
